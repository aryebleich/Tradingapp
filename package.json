{
  "name": "quantpocket-web",
  "version": "1.0.0",
  "description": "Brightolio web platform: backtesting, paper & live trading (Alpaca), QuantConnect, SMS/voice control, scheduled trades, tax reports.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23 || >=24.22.3 <25 || >=26.13.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./test/setup.js --test --test-force-exit test/*.test.js",
    "e2e": "node test/e2e/run.mjs",
    "security:check": "node scripts/security-check.mjs",
    "clean": "node scripts/clean-check.mjs && node scripts/readme-check.mjs",
    "aichat:ui": "node test/aichat-ui.mjs",
    "comms:ui": "node test/comms-ui.mjs",
    "comms:sim": "node scripts/comms-webhook-sim.mjs",
    "tools:ui": "node test/tradetools-ui.mjs",
    "layout:gate": "bash test/layout/gate.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@libsql/client": "^0.18.0",
    "@simplewebauthn/server": "^13.3.3",
    "compression": "^1.8.2",
    "esbuild": "^0.25.12",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "playwright": "^1.56.1"
  }
}
