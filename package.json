{
  "name": "quantpocket-web",
  "version": "1.0.0",
  "description": "Brightolio web platform: backtesting, paper & live trading (Alpaca), QuantConnect, SMS/voice control, scheduled trades, tax reports.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./test/setup.js --test --test-force-exit test/*.test.js",
    "e2e": "node test/e2e/run.mjs",
    "security:check": "node scripts/security-check.mjs",
    "clean": "node scripts/clean-check.mjs && node scripts/readme-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@libsql/client": "^0.18.0",
    "@simplewebauthn/server": "^13.3.3",
    "compression": "^1.8.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
