{
  "name": "quantpocket-web",
  "version": "1.0.0",
  "description": "Brightfolio web platform: backtesting, paper & live trading (Alpaca), QuantConnect, SMS/voice control, scheduled trades, tax reports.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "e2e": "node test/e2e/run.mjs",
    "yiddish:export": "node scripts/yiddish-labs.mjs export",
    "yiddish:import": "node scripts/yiddish-labs.mjs import",
    "yiddish:translate": "node scripts/yiddish-labs.mjs translate",
    "yiddish:parts": "node scripts/yiddish-labs.mjs parts",
    "yiddish:import-parts": "node scripts/yiddish-labs.mjs import-parts",
    "yiddish:web": "node scripts/yiddish-labs-web.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@libsql/client": "^0.18.0",
    "@simplewebauthn/server": "^13.3.3",
    "compression": "^1.8.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
