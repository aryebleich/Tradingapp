    "responses": {
     "200": {
      "description": "OK"
     },
     "400": {
      "description": "Invalid request (problems listed)"
     },
     "401": {
      "description": "Missing, unknown or revoked key"
     },
     "403": {
      "description": "Missing scope, or a real-money action (website only)"
     },
     "429": {
      "description": "Rate limit for this key"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Deploy"
       }
      }
     }
    }
   }
  },
  "/playbooks/{id}/pause": {
   "post": {
