# Copy to .env for local use, or paste into your host's environment settings.
NODE_ENV=production
PUBLIC_URL=https://quantpocket.onrender.com   # where the app is reachable
ADMIN_EMAIL=you@example.com                   # these accounts get the Owner menu (comma-separate several)
ENCRYPTION_KEY=                               # 32+ random characters; never change it after launch
CRON_SECRET=                                  # random string; same value as the GitHub secret CRON_SECRET

# Database: leave empty for a local file. For free hosting use Turso (turso.tech):
DATABASE_URL=                                 # libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=

# ---- Alpaca ----
# Broker API (sandbox): opens customer brokerage accounts, KYC, ACH and transfers. HTTP Basic auth.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
# Optional: OAuth client credentials instead of the key/secret pair (token from authx).
BROKER_CLIENT_ID=
BROKER_CLIENT_SECRET=
BROKER_TOKEN_URL=https://authx.alpaca.markets/v1/oauth2/token
# Live KYC status feed (GET /v1/events/accounts/status); set to off to rely on polling only.
BROKER_EVENTS=on
# Market data + paper trading key (APCA-API-KEY-ID / APCA-API-SECRET-KEY headers).
# Without it, market data uses the data sandbox with the Broker API keys.
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex                         # iex (free) or sip (paid)
# OAuth2 app (alpaca.markets > OAuth Apps) so users can connect their own Alpaca account.
# Redirect URI to register: <PUBLIC_URL>/oauth/alpaca/callback
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_ENV=paper                        # paper or live

# Sign in / sign up with Google (console.cloud.google.com > APIs & Services > Credentials >
# OAuth client ID, type "Web application"). Authorized redirect URI: PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Claude for the AI strategy builder and the AI assistant on the company phone number
# (otherwise a keyword parser / plain commands are used)
ANTHROPIC_API_KEY=

# Optional: email for password resets and verification (resend.com, free tier)
RESEND_API_KEY=
EMAIL_FROM=Brightfolio <hello@your-domain.com>

# Optional: SMS + voice hotline (twilio.com). TWILIO_FROM is the company's number: every user
# texts and calls it, and it is shown on the homepage and in the app. In Twilio set the number's
# "A message comes in" webhook to PUBLIC_URL/twilio/sms and "A call comes in" to PUBLIC_URL/twilio/voice.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1...

# Optional: paid plans + debit card deposits (stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
# Yearly prices (2 months free: $290 and $990 a year)
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ELITE_YEARLY=price_...
# Free trial length for new Pro/Elite subscribers, and the credit a referrer earns
# when someone they invited pays for the first time (dollars)
TRIAL_DAYS=14
REFERRAL_CREDIT=10
# Bank (ACH) deposits through Stripe are on by default (0.8%, max $5); STRIPE_ACH=off hides them.
STRIPE_ACH=on
# Helcim (helcim.com): interchange-plus card processing, far cheaper than 2.9% on debit cards.
HELCIM_API_TOKEN=
# Square (2.9% + 30c): Developer dashboard -> your app -> Credentials (access token) and Locations.
# Webhook subscription: URL https://your-app/webhooks/square, event payment.updated; copy its signature key.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_ENV=sandbox
# Authorize.net (2.9% + 30c + $25/month): Account -> API Credentials & Keys (login ID, transaction key,
# signature key). Webhooks: URL https://your-app/webhooks/authorizenet, event authcapture.created.
ANET_LOGIN_ID=
ANET_TRANSACTION_KEY=
ANET_SIGNATURE_KEY=
# ANET_ENV=sandbox
# Your service fee on every deposit, added on top and shown before paying (percent and/or dollars).
DEPOSIT_FEE_PERCENT=0
DEPOSIT_FEE_FIXED=0

# Optional: more brokerages. Tradier and tastytrade need nothing here (users paste their own tokens).
# Schwab: developer.schwab.com app, callback URL PUBLIC_URL/oauth/schwab/callback
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# TradeStation: api.tradestation.com app, callback URL PUBLIC_URL/oauth/tradestation/callback
TRADESTATION_CLIENT_ID=
TRADESTATION_CLIENT_SECRET=

# Optional: credit line on the Yiddish pages, e.g. the name of whoever reviewed the translation
YIDDISH_CREDIT=

# Sites allowed to call the public demo API (the GitHub Pages copy of the homepage)
PUBLIC_ORIGINS=https://aryebleich.github.io
