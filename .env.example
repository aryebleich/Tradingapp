# Copy to .env for local use, or paste into your host's environment settings.
NODE_ENV=production
PUBLIC_URL=https://quantpocket.onrender.com   # where the app is reachable
ADMIN_EMAIL=you@example.com                   # this account gets the Admin page
ENCRYPTION_KEY=                               # 32+ random characters; never change it after launch
CRON_SECRET=                                  # random string; same value as the GitHub secret CRON_SECRET

# Database: leave empty for a local file. For free hosting use Turso (turso.tech):
DATABASE_URL=                                 # libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=

# ---- Alpaca ----
# Broker API (sandbox): opens customer brokerage accounts, KYC, ACH and transfers. HTTP Basic auth.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
# Market data + paper trading key (APCA-API-KEY-ID / APCA-API-SECRET-KEY headers).
# Without it, market data uses the data sandbox with the Broker API keys.
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex                         # iex (free) or sip (paid)
# OAuth2 app (alpaca.markets > OAuth Apps) so users can connect their own Alpaca account.
# Redirect URI to register: <PUBLIC_URL>/oauth/alpaca/callback
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_ENV=paper                        # paper or live

# Optional: Claude for the AI strategy builder (otherwise a keyword parser is used)
ANTHROPIC_API_KEY=

# Optional: email for password resets and verification (resend.com, free tier)
RESEND_API_KEY=
EMAIL_FROM=QuantPocket <hello@your-domain.com>

# Optional: SMS + voice hotline (twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1...

# Optional: paid plans + debit card deposits (stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
# Yearly prices (2 months free: $290 and $990 a year)
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ELITE_YEARLY=price_...
# Free trial length for new Pro/Elite subscribers, and the credit a referrer earns
# when someone they invited pays for the first time (dollars)
TRIAL_DAYS=14
REFERRAL_CREDIT=10

# Sites allowed to call the public demo API (the GitHub Pages copy of the homepage)
PUBLIC_ORIGINS=https://aryebleich.github.io
